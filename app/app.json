{
  "expo": {
    "name": "Daily Noti",
    "slug": "daily-noti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily-noti",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fcm.app"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF7FD",
        "foregroundImage": "./assets/images/logo-final.png"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.fcm.app"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      ["expo-notifications"],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF7FD",
          "image": "./assets/images/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-image"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "79b49351-8ad4-4707-9fc5-ad1372c5f419"
      }
    }
  }
}
